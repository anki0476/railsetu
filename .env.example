# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
SARVAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Generate a long random value locally. It signs short-lived approval tokens and is not a vendor key.
JAMVANTA_APPROVAL_SECRET=

# Required only when a real payment adapter is connected. Provider webhooks must sign the raw body with this secret.
PAYMENT_WEBHOOK_SECRET=

# Public browser key. Restrict it in Google Cloud to the Maps JavaScript API and
# to localhost plus the production railsetu chatgpt.site origin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Native RailSetu WhatsApp agent. These values come from the Meta developer app.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
# Optional bearer secret for invoking the durable outbound-event dispatcher.
WHATSAPP_DISPATCH_SECRET=
CHANNEL_IDENTITY_SECRET=
RAILSETU_PUBLIC_URL=http://localhost:3000
