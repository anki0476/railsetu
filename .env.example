# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
SARVAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Generate a long random value locally. It signs short-lived approval tokens and is not a vendor key.
JAMVANTA_APPROVAL_SECRET=

# Required only when a real payment adapter is connected. Provider webhooks must sign the raw body with this secret.
PAYMENT_WEBHOOK_SECRET=

# Public browser key. Restrict it in Google Cloud to the Maps JavaScript API and
# to localhost plus the production railsetu chatgpt.site origin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
